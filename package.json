{
  "name": "openclaw-plugin-workboard-controller",
  "version": "0.5.0",
  "type": "module",
  "private": true,
  "description": "Local Workboard controller for OpenClaw terminal owner wakes, dispatch, start notifications, and archive planning.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "plugin:validate": "npm run build && node ./scripts/validate-plugin.mjs",
    "test": "vitest run --config ./vitest.config.ts",
    "verify": "npm run build && npm test && npm run plugin:validate"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "peerDependencies": {
    "openclaw": "2026.7.1-2"
  },
  "dependencies": {
    "typebox": "1.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "openclaw": "2026.7.1-2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yubingjiaocn/openclaw-workboard-controller.git"
  },
  "bugs": {
    "url": "https://github.com/yubingjiaocn/openclaw-workboard-controller/issues"
  },
  "homepage": "https://github.com/yubingjiaocn/openclaw-workboard-controller#readme"
}
